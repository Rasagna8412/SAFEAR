# ==============================================================================
# SafeAR — Industrial Vocational Safety Platform Environment Configuration
# ==============================================================================

# Application Mode
VITE_APP_ENV=development
VITE_USE_FIREBASE_AUTH=false
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Firebase Project Configuration
VITE_FIREBASE_API_KEY=fake-api-key-for-emulator
VITE_FIREBASE_AUTH_DOMAIN=safe-ar-prototype.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=safe-ar-prototype
VITE_FIREBASE_STORAGE_BUCKET=safe-ar-prototype.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Emulator Ports
FIREBASE_AUTH_PORT=9099
FIREBASE_FIRESTORE_PORT=8080
FIREBASE_STORAGE_PORT=9199
FIREBASE_FUNCTIONS_PORT=5001
FIREBASE_UI_PORT=4000

# Blockchain Local EVM Configuration
VITE_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
VITE_CERTIFICATE_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
